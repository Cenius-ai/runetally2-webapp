# RuneTally2 environment variables.
#
# The CLI reads these straight from the process environment. It does NOT parse
# .env files (standard library only), so export them before running, e.g.
#
#   export RUNETALLY_PASSPHRASE=cenius
#   python3 runetally.py list
#
# Both variables are optional: with neither set, the CLI prompts for the
# passphrase (interactive terminals only) and uses ./runetally.json.

# Operator passphrase for catalog-mutating and reading commands.
# Leave empty to be prompted instead. The demo/seed passphrase is: cenius
RUNETALLY_PASSPHRASE=

# Catalog file path. CLI --file wins over this; default is ./runetally.json
RUNETALLY_FILE=./runetally.json

# Operator label stored in the catalog next to the PBKDF2 hash (informational).
RUNETALLY_OPERATOR=cenius
